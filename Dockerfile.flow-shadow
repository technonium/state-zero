# Separate image for the non-publishing Google Flow shadow service.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg openssh-client libsm6 libxext6 libxrender1 libgomp1 \
      xvfb xauth x11vnc ca-certificates curl gnupg git \
 && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
      | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
 && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" \
      > /etc/apt/sources.list.d/google-chrome.list \
 && apt-get update && apt-get install -y --no-install-recommends google-chrome-stable \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Reviewed develop commit, 2026-09-27. Rebuild and repeat the live gate before changing it.
ARG GFLOW_COMMIT=88ff5371c25551af28ab748691f70d32e33ab37c
RUN pip install --no-cache-dir "playwright==1.61.0" \
    "gflow-cli @ git+https://github.com/ffroliva/gflow-cli.git@${GFLOW_COMMIT}"

COPY . .
ENV PYTHONUNBUFFERED=1 \
    GFLOW_CLI_HEADLESS=false \
    GFLOW_CLI_UPDATE_CHECK=0 \
    GFLOW_CLI_HISTORY_PROMPTS=redacted \
    GFLOW_PROFILE=shadow \
    STATE_ZERO_PRIVATE_ROOT=/opt/state-zero-flow-shadow \
    GFLOW_CLI_HOME=/opt/state-zero-flow-profile \
    PIPELINE_MODE=automatic \
    PIPELINE_POST_TO_INSTAGRAM=false \
    PIPELINE_MEDIA_MODE=local_test \
    PORTFOLIO_MEDIA_ENABLED=true \
    MEDIA_GENERATION_PROVIDER=flow \
    FLOW_API_FALLBACK_ENABLED=false \
    GOOGLE_API_FALLBACK_ENABLED=false \
    PIPELINE_TIMEZONE=Asia/Kolkata

# Dokploy's Application Schedule Job execs the runner in this live container.
CMD ["sleep", "infinity"]
