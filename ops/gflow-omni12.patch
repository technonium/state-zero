+def is_omni12_i2v_model(model: object) -> bool:
+    """Accept only the approved 720p, eight-second start-frame wire family."""
+    if not isinstance(model, str) or not re.fullmatch(r"macaron_cookie_[a-z0-9_]+", model):
+        return False
+    tokens = model.split("_")
+    return (tokens.count("i2v") == 1 and "i2v_fl" not in model
+            and not any(value in model for value in ("r2v", "t2v", "extend"))
+            and all(not re.fullmatch(r"\d+(?:p|k)", token) or token == "720p" for token in tokens)
+            and all(not re.fullmatch(r"\d+s", token) or token == "8s" for token in tokens))
 
 
