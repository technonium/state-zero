+async def _guard_shadow_image_submit(route: Any, raw_request: Any,
+                                     reference_ids: tuple[str, ...], model: ImageModel | None) -> str | None:
+    body = _post_data(raw_request)
+    problem = _image_body_problem(body, reference_ids, model)
+    payload = _image_submit_payload(body)
+    if not problem and model is ImageModel.NARWHAL and (
+        len(payload[1]) != 1 or payload[2] != 1 or payload[1][0][4] != 4
+    ):
+        problem = "migrated host: image submit differs from requested 3:4 and count 1"
+    marker = os.getenv("GFLOW_SHADOW_SUBMIT_MARKER")
+    if marker:
+        evidence = {"state": "blocked_before_submission" if problem else "forwarded",
+                    "expected_model": model.value if model else None,
+                    "actual_model": payload[1][0][5] if payload and isinstance(payload[1][0][5], str) and payload[1][0][5] in
+                        {"NARWHAL", "BELUGA", "GEM_PIX_2", "HARBOR_SEAL"} else "unknown",
+                    "reason": problem}
+        target = Path(marker)
+        temporary = target.with_suffix(target.suffix + ".tmp")
+        with os.fdopen(os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as handle:
+            json.dump(evidence, handle)
+        os.replace(temporary, target)
+    if problem:
+        await route.abort()
+    else:
+        # Recorded before forwarding: a crash after this point stays uncertain.
+        await route.continue_()
+    return problem
 
 
