+def _image_submit_payload(body: str) -> list[Any] | None:
+    """Read the measured ogiZ0b payload, never search prompt text for a model."""
+    try:
+        outer, _ = json.JSONDecoder().raw_decode(body.split("f.req=", 1)[1])
+        rows = [row for group in outer for row in group if row[0] == IMAGE_SUBMIT_RPC]
+        if len(rows) != 1:
