+def _image_submit_payload(body: str) -> list[Any] | None:
+    """Read the measured ogiZ0b payload, never search prompt text for a model."""
+    try:
+        outer, _ = json.JSONDecoder().raw_decode(body.split("f.req=", 1)[1])
+        rows = [row for group in outer for row in group if row[0] == IMAGE_SUBMIT_RPC]
+        if len(rows) != 1:
+            return None
+        payload = json.loads(rows[0][1])
+        if not isinstance(payload, list) or len(payload) < 3 or not isinstance(payload[1], list) or not payload[1]:
+            return None
+        if any(not isinstance(row, list) or len(row) <= 5 for row in payload[1]):
+            return None
+        return payload
+    except (ValueError, TypeError, IndexError, KeyError):
+        return None
