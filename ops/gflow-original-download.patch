+async def _download_original_verified(page: Page, *, expected: int | None, media_id: str) -> bytes:
+    """Read the exact original blob without Chrome's crashing native download path."""
+    import base64
+    import contextlib
+    import re
+
+    if type(expected) is not int or not 0 < expected <= 100 * 1024 * 1024:
+        raise WireFormatError(detail="Original clip byte count is missing; refusing unverified download", route=_ROUTE)
+    address = urlsplit(page.url)
+    if (address.scheme != "https" or address.hostname != "flow.google.com"
+            or address.port not in (None, 443) or address.username or address.password
+            or not address.path.endswith("/edit/" + media_id)):
+        raise WireFormatError(detail="Original download editor identity differs", route=_ROUTE)
+    await page.evaluate("""({expected}) => {
+        if (window.__stateZeroOriginalDownload) throw Error('Original download already active');
+        const create = URL.createObjectURL, click = HTMLAnchorElement.prototype.click;
+        const blobs = new Map();
+        let finish;
+        const promise = new Promise(resolve => { finish = resolve; });
+        window.__stateZeroOriginalDownload = {create, click, promise, finish};
+        URL.createObjectURL = function(blob) {
+            const url = create.call(URL, blob);
+            if (blob instanceof Blob && blob.type === 'video/mp4' && blob.size === expected) blobs.set(url, blob);
+            return url;
+        };
+        HTMLAnchorElement.prototype.click = function() {
+            if (!this.download) return click.call(this);
+            const blob = blobs.get(this.href);
+            // Never fall back to the native download, including on untrusted/mismatched data.
+            if (!this.href.startsWith('blob:' + location.origin + '/') || !blob) {
+                finish({error: 'Original download blob identity or byte count differs'});
+                return;
+            }
+            const reader = new FileReader();
+            reader.onload = () => finish({base64: String(reader.result).split(',')[1]});
+            reader.onerror = () => finish({readFailed: true});
+            reader.readAsDataURL(blob);
+        };
+    }""", {"expected": expected})
+    try:
+        await page.get_by_role("button", name="Download media", exact=True).click(timeout=10000)
+        option = page.get_by_role("menuitem", name=re.compile(r"720p", re.I))
+        if await option.count() != 1:
+            raise WireFormatError(detail="Original 720p download option is ambiguous or missing", route=_ROUTE)
+        await page.evaluate("""() => {
+            const capture = window.__stateZeroOriginalDownload;
+            capture.timer = setTimeout(() => capture.finish({timedOut: true}), 120000);
+        }""")
+        await option.click(timeout=5000)
+        result = await page.evaluate("() => window.__stateZeroOriginalDownload.promise")
+        if result.get("timedOut"):
+            raise TimeoutError("Original blob download timed out")
+        if result.get("readFailed"):
+            raise OSError("Original blob read failed")
+        if result.get("error"):
+            raise WireFormatError(detail=result["error"], route=_ROUTE)
+        body = base64.b64decode(result["base64"], validate=True)
+        _verify(body, expected=expected, media_id=media_id)
+        return body
+    finally:
+        with contextlib.suppress(Exception):
+            await page.evaluate("""() => {
+                const saved = window.__stateZeroOriginalDownload;
+                if (saved) {
+                    URL.createObjectURL = saved.create;
+                    HTMLAnchorElement.prototype.click = saved.click;
+                    clearTimeout(saved.timer);
+                    delete window.__stateZeroOriginalDownload;
+                }
+            }""")
+
