+def _is_original_download_url(url: str) -> bool:
+    parts = urlsplit(url)
+    if parts.scheme == "blob":
+        origin = urlsplit(parts.path)
+        return origin.scheme == "https" and origin.hostname == "flow.google.com"
+    from gflow_cli.api.transports.ui_automation import _is_allowed_download_host
+    return _is_allowed_download_host(url)
+
