+def _mark_shadow_submit_attempt() -> None:
+    """Persist the credit-spending boundary for State Zero's isolated runner."""
+    raw = os.getenv("GFLOW_SHADOW_SUBMIT_MARKER")
+    if raw:
+        try:
+            fd = os.open(raw, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+        except FileExistsError as exc:
+            raise WireFormatError(detail="submitted_request_uncertain: existing submission marker; reconcile before retry") from exc
+        with os.fdopen(fd, "w") as marker:
+            marker.write("submit_attempted\n")
 
 
+def _raise_after_shadow_submission(exc: Exception) -> None:
+    """Do not let an outer transport retry submit another paid request."""
+    raw = os.getenv("GFLOW_SHADOW_SUBMIT_MARKER")
+    if not raw or not Path(raw).exists():
+        return
+    try:
+        if json.loads(Path(raw).read_text()).get("state") == "blocked_before_submission":
+            return
+    except (OSError, ValueError, AttributeError):
+        pass
+    from gflow_cli.data.redaction import redact_error_detail
+    from gflow_cli.errors import GFlowError
+    detail = redact_error_detail(str(exc.to_problem_details().get("detail", ""))) if isinstance(exc, GFlowError) else ""
+    raise WireFormatError(
+        detail=f"submitted_request_uncertain: {type(exc).__name__}: {detail}; reconcile before retry"
+    ) from exc
+
