# ── Private Storage Root ───────────────────────────────────────
# Local default: ~/State Zero Private
# Production default: /opt/state-zero-private
# In Dokploy, set this explicitly to your mounted private volume path.
STATE_ZERO_PRIVATE_ROOT=

# ── Media Hosting Mode ──────────────────────────────────────────
# local_test = local laptop testing with ngrok serving runtime/local_vps
# live_vps   = upload media to your VPS host folder and serve it from VPS_PUBLIC_BASE_URL
# If unset, the app infers local_test when VPS_SSH_HOST=localhost, otherwise live_vps.
PIPELINE_MEDIA_MODE=

# ── WHOOP OAuth ────────────────────────────────────────────────
# WHOOP_CLIENT_ID / WHOOP_CLIENT_SECRET stay in env vars.
# WHOOP_ACCESS_TOKEN / WHOOP_REFRESH_TOKEN are bootstrap values only.
# After first successful auth/refresh, private runtime state becomes the source of truth.
# Run auth_whoop.py once to seed the private state file.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_ACCESS_TOKEN=
WHOOP_REFRESH_TOKEN=
# ── LLM: OpenRouter (Primary — Claude Haiku) ───────────────────
OPENROUTER_API_KEY=
# ── LLM: Google Gemini (Fallback) ─────────────────────────────
GOOGLE_API_KEY_PRIMARY=
GOOGLE_API_KEY_FALLBACK=
# Set to true to enable fallback key usage (default: false)
GOOGLE_API_FALLBACK_ENABLED=false
# ── Image Generation (Imagen via Google) ──────────────────────
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image-preview
# ── Video Generation (VEO via Google) ─────────────────────────
GOOGLE_VIDEO_MODEL=veo-3.1-fast-generate-preview
GOOGLE_VIDEO_TIMEOUT_SECONDS=900
GOOGLE_VIDEO_POLL_SECONDS=10
# ── Instagram Graph API ────────────────────────────────────────
# INSTAGRAM_ACCESS_TOKEN is a bootstrap/override value.
# Private runtime state becomes the durable source after the first successful run.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Token lifecycle mode:
# off = validate token before posting; fail fast if invalid/expired (recommended)
# legacy_ig = also attempt graph.instagram.com refresh endpoint (legacy compatibility)
# hybrid = fail-fast + proactive refresh near expiry with cooldown (recommended automation mode)
INSTAGRAM_AUTO_REFRESH_MODE=hybrid
INSTAGRAM_REFRESH_THRESHOLD_DAYS=14
INSTAGRAM_REFRESH_COOLDOWN_HOURS=12
# Optional for expiry-aware token alerts via Graph debug_token
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_TOKEN_HEALTHCHECK_ENABLED=true
INSTAGRAM_TOKEN_ALERT_DAYS=14,7,3,1
# ── VPS / Public URL ───────────────────────────────────────────
# Base URL where Instagram can download your media.
# Local test example: your ngrok URL
# Live example: https://yourdomain.com/media
VPS_PUBLIC_BASE_URL=
# Required only in live_vps mode
VPS_SSH_HOST=
VPS_SSH_USER=
# Host-served folder used by scp in live_vps mode
VPS_SSH_PATH=/srv/state-zero-media
# ── Telegram Manual-First Mode ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ── Telegram Notification Settings ──────────────────────────────────
# Enable/disable error notifications
TELEGRAM_NOTIFY_ERRORS=true
# Enable/disable success notifications
TELEGRAM_NOTIFY_SUCCESS=true
# Dedupe window in seconds (default: 300 = 5 minutes)
TELEGRAM_ERROR_DEDUPE_SECONDS=300
# Number of stderr/stdout lines to include in error notifications
TELEGRAM_NOTIFY_INCLUDE_STDERR_LINES=40
